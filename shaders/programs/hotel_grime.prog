name hotel_grime
lib standard
define STANDARD
param shaderType MeshStandardMaterial
param shaderName
param useFog
param fog
param fogExp2
param map
param envMap
param envMapModeDefine ENVMAP_MODE_REFLECTION
param mapUv uv
param vertexNormals
param vertexColors
param shadowMapEnabled
param shadowMapTypeDefine SHADOWMAP_TYPE_PCF
