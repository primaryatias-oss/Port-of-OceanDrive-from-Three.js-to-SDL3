        float odTx = 57.0 + 4.0 * sin(odZ / 37.0) + 1.5 * sin(odZ / 13.0 + 1.0);
        float odT1 = abs(odX - odTx - 0.82), odT2 = abs(odX - odTx + 0.82);
        float odTd = min(odT1, odT2);
