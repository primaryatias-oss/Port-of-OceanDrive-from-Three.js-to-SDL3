        vec3 odWc = mix(vec3(0.17, 0.13, 0.06), vec3(0.42, 0.32, 0.14), surfN(vec2(odZ * 5.0, odX * 5.0)));
        diffuseColor.rgb = mix(diffuseColor.rgb, odWc, odWr);
