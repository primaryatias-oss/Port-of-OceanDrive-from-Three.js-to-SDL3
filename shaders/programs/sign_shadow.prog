# MeshBasicMaterial (sign-shadow-v1) - 2 material(s): Scene/hotels/Group/Mesh
# generated by tools/ref/gen-progs.mjs from the JS app's own program + onBeforeCompile patches
name sign_shadow
lib basic
param shaderType MeshBasicMaterial
param shaderName
param useFog
param fog
param fogExp2
param map
param mapUv uv
param vertexNormals
param shadowMapEnabled
param shadowMapTypeDefine SHADOWMAP_TYPE_PCF
@replace vertex #include <begin_vertex>
#include <begin_vertex>
transformed += -normal * 0.05 + vec3(0.0, -0.03, 0.0);
@end
@replace fragment #include <map_fragment>

        vec2 odTs = 1.5 / vec2(textureSize(map, 0));
        float odA = 0.0;
        for (int i = -1; i <= 1; i++) for (int j = -1; j <= 1; j++) odA += texture2D(map, vMapUv + vec2(float(i), float(j)) * odTs * 4.0).a;
        diffuseColor.a *= odA / 9.0;
@end
