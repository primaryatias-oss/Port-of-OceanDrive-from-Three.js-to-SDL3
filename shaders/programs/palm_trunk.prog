@replace vertex #include <common>
#include <common>

uniform float odWindT;
vec3 odSway(vec3 p) {
  float ph = dot(p.xz, vec2(0.05, 0.03));
  float s = sin(odWindT * 0.8 + ph) + 0.35 * sin(odWindT * 1.9 + ph * 2.1);
  float h = max(p.y, 0.0) / 12.0;
  return vec3(0.75, 0.0, 0.45) * 0.022 * s * h * h;
}
@end
