# generated by tools/ref/gen-progs.mjs from the JS app's own program + onBeforeCompile patches
name tower_soffit
lib standard
define STANDARD
param shaderType MeshStandardMaterial
param shaderName
param useFog
param fog
param fogExp2
param map
param envMap
param envMapModeDefine ENVMAP_MODE_REFLECTION
param mapUv uv
param vertexNormals
param shadowMapEnabled
param shadowMapTypeDefine SHADOWMAP_TYPE_PCF
param envMapTypeDefine ENVMAP_TYPE_CUBE_UV
