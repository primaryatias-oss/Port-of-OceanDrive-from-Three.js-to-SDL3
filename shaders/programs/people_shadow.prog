  float odSand(vec2 p) {
    float x = p.x, z = p.y, h;
    if (x < 86.00000) {
      float t = (x - 12.00000) / 74.00000;
      h = 0.55 - (0.55 - -0.90000) * t;
    } else {
      float t = (x - 86.00000) / 26.0;
      h = -0.90000 - 1.6 * min(1.0, t) * min(1.0, t) - 0.2 * max(0.0, t - 1.0);
    }
    float fade = odSm(12.60000, 16.00000, x) * (1.0 - odSm(82.95000, 87.95000, x))
